# Entorno y Servidor
NODE_ENV=development
PORT=4000

# Base de datos Supabase (Pooler y Conexión Directa para Migraciones)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Autenticación JWT (Obligatorio, sin valor por defecto en código)
JWT_SECRET="reemplazar_con_clave_secreta_de_al_menos_32_caracteres"
JWT_EXPIRES_IN=1d

# Origen permitido para CORS (Frontend)
CORS_ORIGIN=http://localhost:3000

# Supabase Storage para Evidencias y Casos (Case Images)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_supabase_service_role_key"
SUPABASE_BUCKET=case-images
